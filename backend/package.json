{
  "name": "backend",
  "version": "1.0.0",
  "main": "dist/server.js",
  "type": "module",
  "imports": {
    "#domain/*.js": {
      "development": "./src/domain/*.ts",
      "default": "./dist/domain/*.js"
    },
    "#application/*.js": {
      "development": "./src/application/*.ts",
      "default": "./dist/application/*.js"
    },
    "#infrastructure/*.js": {
      "development": "./src/infrastructure/*.ts",
      "default": "./dist/infrastructure/*.js"
    },
    "#api/*.js": {
      "development": "./src/api/*.ts",
      "default": "./dist/api/*.js"
    },
    "#shared/*.js": {
      "development": "./src/shared/*.ts",
      "default": "./dist/shared/*.js"
    }
  },
  "scripts": {
    "dev": "tsx --conditions=development watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "config": "^4.4.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "mongoose": "^9.7.2",
    "ohash": "^2.0.11"
  },
  "devDependencies": {
    "@types/config": "^3.3.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.0",
    "install": "^0.13.0",
    "jsonwebtoken": "^9.0.3",
    "npm": "^10.9.8",
    "prisma": "^6.19.3",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
