// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserType {
  ADMIN
  INSTRUCTOR
  STUDENT
}

enum Specialties {
  Digital
  Eletronics
}

enum Action {
  CREATED
  DELETED
  UPDATED
}

enum EntityType {
  Class
  Compentence
  Material
  Instructor
  Discipline
  Area
  Student
  Exam
  Admin
}

model Admin {
  id Int @default(autoincrement()) @id
  createdAt DateTime @default(now())
  username String @unique
  password String
  userType UserType @default(ADMIN)
  specialty Specialties
  active Boolean @default(false)
  updatedPasswordAt DateTime @default(now())
  firstAccess Boolean @default(true)
  attachmentId String?

  logs Log[]
}

model Instructor {
  id Int @default(autoincrement()) @id
  createdAt DateTime @default(now())
  username String @unique
  password String
  userType UserType @default(INSTRUCTOR)
  specialty Specialties
  active Boolean @default(false)
  updatedPasswordAt DateTime @default(now())
  firstAccess Boolean @default(true)
  attachmentId String?

  logs Log[]
}

model Student {
  id Int @default(autoincrement()) @id
  createdAt DateTime @default(now())
  username String @unique
  password String
  userType UserType @default(STUDENT)
  active Boolean @default(true)
  updatedPasswordAt DateTime @default(now())
  firstAccess Boolean @default(true)
}

model Class {
  id Int @default(autoincrement()) @id
  name String
  content String @db.Text
  createdAt DateTime @default(now())
  disciplineId Int
  discipline Discipline @relation(fields: [disciplineId], references: [id], onDelete: Cascade)
  competences Competence[]
  materials Material[]
}

model Competence {
  id Int @default(autoincrement()) @id
  name String
  numOfClasses Int @default(0)
  createdAt DateTime @default(now())

  classes Class[] //n-n
  exams Exam[] //n-n
  disciplines Discipline[] //n-n
}

model Discipline {
  id Int @default(autoincrement()) @id
  name String
  workLoad Int @default(0)
  areaId Int
  area Area @relation(fields: [areaId], references: [id])
  materials Material[]
  competences Competence[] //n-n
  classes Class[] //n-n
  exams Exam[] //n-n
}

model Area {
  id Int @default(autoincrement()) @id
  name String
  color String

  disciplines Discipline[]
}

model Material {
  id Int @default(autoincrement()) @id
  name String
  attachments MaterialAttachment[]

  disciplineId Int
  discipline Discipline @relation(fields: [disciplineId], references: [id], onDelete: Cascade)
  classId Int
  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)
}

model Exam {
  id Int @default(autoincrement()) @id
  name String
  attachments ExamAttachment[]

  disciplineId Int
  discipline Discipline @relation(fields: [disciplineId], references: [id])
  competences Competence[]
}

model Log {
  id Int @default(autoincrement()) @id
  entityType EntityType
  entityId Int
  entityName String
  action Action
  updatedAt DateTime @default(now())
  oldData Json
  newData Json
  instructorId Int?
  adminId Int?
  instructor Instructor? @relation(fields: [instructorId], references: [id])
  admin Admin? @relation(fields: [adminId], references: [id])
  username String
}

model ExamAttachment {
  id Int @id @default(autoincrement())
  examId Int
  attachmentId String

  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@index([examId])
}

model MaterialAttachment {
  id Int @id @default(autoincrement())
  materialId Int
  attachmentId String

  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  
  @@index([materialId])
}