// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserType {
  ADMIN
  INSTRUCTOR
  STUDENT
}

enum Specialties {
  Digital
  Eletronics
}

enum Action {
  CREATED
  DELETED
  UPDATED
}

enum EntityType {
  Class
  Compentence
  Material
  Instructor
  Discipline
  Area
  Student
  Exam
}


model Instructor {
  id Int @default(autoincrement()) @id
  name String
  createdAt DateTime @default(now())
  username String
  password String
  userType UserType @default(INSTRUCTOR)
  specialty Specialties
  active Boolean @default(true)
  attachmentId String

  logs Log[]
  students Student[]
}

model Student {
  id Int @default(autoincrement()) @id
  name String
  createdAt DateTime @default(now())
  username String
  password String
  userType UserType @default(STUDENT)
  course String
  attachmentId String

  areas Area[]
  instructorId Int
  instructor Instructor @relation(fields: [instructorId], references: [id])
}

model Class {
  id Int @default(autoincrement()) @id
  name String
  content String @db.Text
  createdAt DateTime @default(now())
  disciplineId Int
  discipline Discipline @relation(fields: [disciplineId], references: [id])
  competences Competence[]
  materials Material[]
}

model Competence {
  id Int @default(autoincrement()) @id
  name String
  numOfClasses Int @default(0)
  createdAt DateTime @default(now())

  classes Class[]
  exams Exam[]
  disciplines Discipline[]
}

model Discipline {
  id Int @default(autoincrement()) @id
  name String
  createdAt DateTime @default(now())
  workLoad Int
  areaId Int
  area Area @relation(fields: [areaId], references: [id])
  materials Material[]
  competences Competence[]
  classes Class[]
  exams Exam[]
}

model Area {
  id Int @default(autoincrement()) @id
  name String

  disciplines Discipline[]
  students Student[]
}

model Material {
  id Int @default(autoincrement()) @id
  name String
  attachmentId String

  disciplineId Int
  discipline Discipline @relation(fields: [disciplineId], references: [id])
  classId Int
  class Class @relation(fields: [classId], references: [id])
}

model Exam {
  id Int @default(autoincrement()) @id
  name String
  attachmentId String

  disciplineId Int
  discipline Discipline @relation(fields: [disciplineId], references: [id])
  competences Competence[]
}

model Log {
  id Int @default(autoincrement()) @id
  entityType EntityType
  entityId Int 
  action Action
  updatedAt DateTime @default(now())
  oldData Json
  newData Json
  instructorId Int
  instructor Instructor @relation(fields: [instructorId], references: [id])
}